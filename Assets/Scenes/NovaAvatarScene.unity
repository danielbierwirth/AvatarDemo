  - "\uC548\uB155 \uB178\uBC14, \uB108\uB294 \uB204\uAD6C\uC57C?"
  - "\uC11C\uC6B8 \uB0A0\uC528 \uC5B4\uB54C?"
  - "\uB274\uC695\uC740 \uC9C0\uAE08 \uBA87 \uC2DC\uC57C?"
  - "\uB098 \uC9C0\uAE08 \uC5B4\uB514\uC5D0 \uC788\uC5B4?"
  - "\uBAA8\uB098\uB9AC\uC790\uB294 \uB204\uAC00 \uADF8\uB838\uC5B4?"
  - "\uC5D0\uBCA0\uB808\uC2A4\uD2B8\uC0B0 \uB192\uC774\uAC00 \uC5BC\uB9C8\uC57C?"
  - "\uD638\uC8FC\uC758 \uC218\uB3C4\uB294 \uC5B4\uB514\uC57C?"
  - "\uBB38\uC5B4\uC5D0 \uB300\uD55C \uC7AC\uBBF8\uC788\uB294 \uC0AC\uC2E4 \uD558\uB098 \uC54C\uB824\uC918."
  - "\uC8FC\uB9D0\uC5D0 \uC77D\uC744 \uB9CC\uD55C \uC88B\uC740 \uCC45 \uCD94\uCC9C\uD574\uC918."
  - "\uACE0\uB9C8\uC6CC, \uC548\uB155!"
  m_CommandsAr:
  - "\u0645\u0631\u062D\u0628\u0627 \u0646\u0648\u0641\u0627\u060C \u0645\u0646 \u0623\u0646\u062A\u061F"
  - "\u0643\u064A\u0641 \u0627\u0644\u0637\u0642\u0633 \u0641\u064A \u0633\u064A\u0648\u0644\u061F"
  - "\u0643\u0645 \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u0622\u0646 \u0641\u064A \u0646\u064A\u0648\u064A\u0648\u0631\u0643\u061F"
