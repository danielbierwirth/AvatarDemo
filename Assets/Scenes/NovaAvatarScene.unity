  - "\u0645\u0646 \u0631\u0633\u0645 \u0627\u0644\u0645\u0648\u0646\u0627\u0644\u064A\u0632\u0627\u061F"
  - "\u0643\u0645 \u064A\u0628\u0644\u063A \u0627\u0631\u062A\u0641\u0627\u0639 \u062C\u0628\u0644 \u0625\u064A\u0641\u0631\u0633\u062A\u061F"
  - "\u0645\u0627 \u0647\u064A \u0639\u0627\u0635\u0645\u0629 \u0623\u0633\u062A\u0631\u0627\u0644\u064A\u0627\u061F"
